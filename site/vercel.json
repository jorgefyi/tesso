{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/docs/:page(install|init|check|add|button|card|dialog)", "destination": "/index.html" },
    { "source": "/docs/:page(install|init|check|add|button|card|dialog)/", "destination": "/index.html" },
    { "source": "/test", "destination": "/index.html" },
    { "source": "/test/", "destination": "/index.html" }
  ]
}
