{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "background": { "$type": "color", "$value": "{gray.12}" },
  "foreground": { "$type": "color", "$value": "{gray.0}" },
  "card": { "$type": "color", "$value": "{gray.11}" },
  "card-foreground": { "$type": "color", "$value": "{gray.0}" },
  "popover": { "$type": "color", "$value": "{gray.11}" },
  "popover-foreground": { "$type": "color", "$value": "{gray.0}" },
  "primary": { "$type": "color", "$value": "{palette-accent.6}" },
  "primary-foreground": { "$type": "color", "$value": "{gray.12}" },
  "secondary": { "$type": "color", "$value": "{gray.10}" },
  "secondary-foreground": { "$type": "color", "$value": "{gray.0}" },
  "muted": { "$type": "color", "$value": "{gray.10}" },
  "muted-foreground": { "$type": "color", "$value": "{gray.4}" },
  "accent": { "$type": "color", "$value": "{gray.9}" },
  "accent-foreground": { "$type": "color", "$value": "{gray.0}" },
  "destructive": { "$type": "color", "$value": "{palette-danger.6}" },
  "destructive-foreground": { "$type": "color", "$value": "{gray.12}" },
  "border": { "$type": "color", "$value": "{gray.10}" },
  "input": { "$type": "color", "$value": "{gray.8}" },
  "ring": { "$type": "color", "$value": "{palette-accent.3}" },
  "success": { "$type": "color", "$value": "{palette-success.6}" },
  "warning": {
    "$type": "color",
    "$description": "Fill and badge color. Do not use this for text.",
    "$value": "{palette-warning.6}"
  },
  "warning-foreground": {
    "$type": "color",
    "$description": "Warning text on background and card. warning.11 is too dim on a dark background.",
    "$value": "{palette-warning.9}"
  },
  "subtle-foreground": { "$type": "color", "$value": "{gray.6}" },
  "border-strong": { "$type": "color", "$value": "{gray.8}" },
  "elevation-color": {
    "sm": { "$type": "color", "$value": "oklch(99% 0.005 260 / 0.07)" },
    "md": { "$type": "color", "$value": "oklch(99% 0.005 260 / 0.10)" },
    "lg": { "$type": "color", "$value": "oklch(99% 0.005 260 / 0.14)" }
  }
}
